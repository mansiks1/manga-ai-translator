AI_SEARCH_PROVIDER=gemini

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional: override only if Google changes the API base URL.
# GEMINI_GENERATE_CONTENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Optional tuning
AI_SEARCH_TIMEOUT_MS=10000
DEEP_SEARCH_QUERY_LIMIT=8
MAX_SEARCH_QUERY_LENGTH=200
MAX_DEEP_SEARCH_QUERY_LENGTH=260
SEARCH_CACHE_TTL_MS=600000
DEEP_SEARCH_CACHE_TTL_MS=3600000
AI_SEARCH_CACHE_TTL_MS=86400000
CACHE_MAX_ENTRIES=300
DEEP_SEARCH_RATE_LIMIT_WINDOW_MS=60000
DEEP_SEARCH_RATE_LIMIT_MAX=8
AI_SEARCH_RATE_LIMIT_WINDOW_MS=60000
AI_SEARCH_RATE_LIMIT_MAX=4
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=10

# Local credits prototype. Deep search is charged only on a successful cache miss.
# These development grants are always disabled when NODE_ENV=production.
INITIAL_USER_CREDITS=3
DEEP_SEARCH_CREDIT_COST=1
DEV_CREDIT_TOP_UP_ENABLED=true
DEV_CREDIT_TOP_UP_AMOUNT=10

# Optional persistent registration, sessions, accounts, and credit ledger.
# Leave unset only when disposable in-memory accounts are acceptable.
# Run `npm.cmd run db:migrate` before starting the server with this value enabled.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/manga_ai_translator

# MangaLib reader source. It uses an unofficial MangaLib/lib.social endpoint,
# so keep the switch here in case the site blocks server requests.
MANGALIB_ENABLED=true
MANGALIB_API_BASE_URL=https://api.cdnlibs.org/api
MANGALIB_SITE_URL=https://mangalib.org
MANGALIB_SITE_ID=1
MANGALIB_CHAPTER_LOOKUP_LIMIT=3
